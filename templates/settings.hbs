<form autocomplete="off">
    <div class="form-group">
        <p class="hint">Click the button below to parse all .json lists in the module's /data folder and generate RollTables for any missing lists in the standard 'NPC Name Randomizer' folder.</p>
    </div>
    
    <div class="form-group">
        <button type="button" data-action="generateTables">
            <i class="fas fa-magic"></i> Generate Missing Default Tables
        </button>
    </div>

    <hr>

    <div class="form-group">
        <p class="hint">Click the button below to automatically import all pre-made NPCs from the module's Compendium pack into an Actor folder named 'Random NPCs' in your world sidebar.</p>
    </div>

    <div class="form-group">
        <button type="button" data-action="importNPCs">
            <i class="fas fa-users"></i> Import Pre-Made NPCs
        </button>
    </div>
</form>
